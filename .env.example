# NASA FIRMS — бесплатный ключ: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=

# NASA Earthdata Login — нужен только для архива FIRMS глубже 2 месяцев
# (bootstrap маски факелов, SPEC-4). https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copernicus CDSE — резервный источник Sentinel-2. Основной (Planetary Computer)
# работает анонимно и учётных данных не требует.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
